{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig*.json", ".env.example"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "inputs": ["openapi/**"],
      "outputs": ["src/schema.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "outputs": ["node_modules/.tmp/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.{ts,tsx}", "!src/test/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["generate"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["BFF_URL"]
    }
  }
}
