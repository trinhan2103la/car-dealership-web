{
  "name": "@car-dealership/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UI dung chung: shadcn (src/components) + component viet tay (src/custom). Chi chua source, khong build.",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
